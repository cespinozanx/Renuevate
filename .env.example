# Copia este archivo como .env (solo para pruebas locales con `vercel dev`).
# En produccion, estas variables se configuran en Vercel > Project Settings > Environment Variables,
# NUNCA se suben al repositorio.

# MongoDB Atlas (ver README.md, seccion "1. MongoDB Atlas")
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=azura

# Google Cloud OAuth (ver README.md, seccion "2. Google OAuth")
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Meta for Developers - Facebook Login (ver README.md, seccion "3. Facebook Login")
FACEBOOK_APP_ID=tu-facebook-app-id
FACEBOOK_APP_SECRET=tu-facebook-app-secret

# Motor de promociones y lealtad (ver db/schema.md)
# Secreto compartido para llamadas admin a api/promotions.js y api/loyalty-rules.js.
# Esto es un minimo viable, NO reemplaza autenticacion real de administrador.
ADMIN_API_KEY=genera-un-secreto-largo-y-aleatorio

# SMS OTP (Twilio) - registro/login por telefono, ver lib/sendSms.js
TWILIO_ACCOUNT_SID=tu-account-sid
TWILIO_AUTH_TOKEN=tu-auth-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# WhatsApp OTP (Twilio como BSP de Meta) - OPCIONAL pero recomendado: ~20-50x mas
# barato que SMS a este volumen. Si estas 2 variables existen, se usa WhatsApp en
# vez de SMS automaticamente (ver lib/sendWhatsapp.js). Requiere una plantilla de
# WhatsApp categoria "Authentication" aprobada por Meta (1-3 dias habiles).
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nota: las URLs de redes sociales (Instagram/TikTok/Facebook) y el ID de Google
# Analytics 4 NO van aqui -- son valores publicos del lado del cliente y se
# configuran directamente en AZURA_CONFIG dentro de index.html (buscar
# "SOCIAL_INSTAGRAM_URL" / "GA4_MEASUREMENT_ID").

# Mercado Pago (Checkout Pro) - ver README.md seccion "Mercado Pago" para el
# paso a paso completo. El sitio NUNCA captura el numero de tarjeta: este
# access token solo sirve para crear la "preferencia" de pago (api/checkout.js)
# y para que el webhook (api/checkout-webhook.js) confirme el estado del pago.
# Usa primero tus credenciales de PRUEBA (TEST-...) hasta validar el flujo
# completo con una tarjeta de prueba; cambia a las de produccion hasta el final.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx

# URL publica del sitio (sin / al final) - se usa para armar las back_urls y
# la notification_url del webhook de Mercado Pago. En Vercel puedes omitirla
# y se usa VERCEL_URL automaticamente, pero se recomienda fijarla explicita.
SITE_URL=https://azura-wellness-site.vercel.app
